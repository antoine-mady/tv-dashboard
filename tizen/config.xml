<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://tvdashboard.local/TVDashboard" version="1.0.0" viewmodes="maximized">
  <tizen:application id="TVDashBrd0.TVDashboard" package="TVDashBrd0" required_version="6.0"/>
  <name>TVDashboard</name>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:profile name="tv-samsung"/>

  <!-- Autorise les requêtes vers n'importe quelle origine (API météo, DLNA de la box, YouTube…) -->
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>

  <!-- Politique de sécurité (CSP). Sans elle, Tizen n'autorise que les scripts embarqués et bloque le lecteur YouTube.
       Un widget qui charge un script / une iframe / un média externe doit ajouter son hôte ici.
       L'aperçu (npm run dev) applique la même politique. -->
  <tizen:content-security-policy>default-src 'self' file: data: blob:; script-src 'self' file:; style-src 'self' file: 'unsafe-inline'; img-src * file: data: blob:; media-src * file: blob:; frame-src 'self' https://antoine-mady.github.io; connect-src *</tizen:content-security-policy>

  <tizen:privilege name="http://developer.samsung.com/privilege/voicecontrol"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>

  <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
