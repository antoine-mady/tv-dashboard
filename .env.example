# Copier ce fichier en .env.local et compléter.
# IP de la TV (Paramètres > Général > Réseau > État du réseau)
TV_IP=192.168.1.50
# Nom du profil de certificat créé dans Tizen Studio (Certificate Manager)
TIZEN_PROFILE=tv-dashboard
# Dossier d'installation de Tizen Studio (optionnel si `tizen` et `sdb` sont dans le PATH)
TIZEN_HOME=~/tizen-studio
